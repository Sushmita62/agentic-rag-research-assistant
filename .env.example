# Copy this to .env and fill in your key. NEVER commit .env.

# Groq (open-weights LLM, free tier)
GROQ_API_KEY=your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Local models (auto-downloaded on first use, no key needed)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base

# Paths (relative to repo root)
DATA_DIR=data
DB_PATH=data/index/app.db
FAISS_PATH=data/index/faiss.index
BM25_PATH=data/index/bm25.pkl

# Silence "unauthenticated HF Hub" warnings by using cached models only.
# Turn off (unset) if you want to auto-check for model updates.
HF_HUB_OFFLINE=1

# Upload cap
MAX_UPLOAD_MB=30
